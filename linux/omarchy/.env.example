# Copy to .env and fill in — never commit .env (see repo .gitignore).
# Shell environment variables override values here when bootstrap.sh runs.
#
#   cp .env.example .env
#
# Quote values that contain spaces. Unquoted lines like:
#   GIT_NAME=Steven Roomberg
# are invalid shell and make `source .env` fail when bootstrap.sh runs (set -e).

# Git identity (skip interactive prompts when set)
GIT_NAME="Steven Roomberg"
GIT_EMAIL="you@example.com"

# Backup staging directory (must contain .ssh/ etc.)
BACKUP_ROOT="${HOME}/Backups/omarchy-restore"

# Run ssh-add on restored private keys (1 = yes, 0 = no)
SSH_ADD_KEYS=1
